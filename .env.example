
# FleetSync local PostgreSQL configuration
# Copy this file to .env and choose your own password.

POSTGRES_PASSWORD=replace-with-your-own-local-password

# FleetSync web app (read by apps/web via Vite envDir).
# "/api" goes through the Vite dev proxy (apps/web/vite.config.ts) to the API on
# http://localhost:5215, so the HttpOnly refresh cookie works. Set API_PROXY_TARGET
# to point the proxy somewhere else.
VITE_API_BASE_URL=/api
