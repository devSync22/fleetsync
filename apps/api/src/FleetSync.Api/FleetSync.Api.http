# FleetSync API requests for the VS Code REST Client / Rider / Visual Studio.
# Emailed links (verify, reset, activate) are saved in App_Data/dev-emails/ in Development.

@host = http://localhost:5215
@email = sachini@example.com
@password = Fleet2026Pass

### Liveness
GET {{host}}/health/live

### Readiness (PostgreSQL)
GET {{host}}/health/ready

### Register a customer
POST {{host}}/api/auth/register/customer
Content-Type: application/json

{
  "companyName": "Hayleys Freight (Pvt) Ltd",
  "businessRegistrationNo": "PV 12345",
  "billingAddress": "No. 25, Galle Road, Colombo 03",
  "fullName": "Sachini Fernando",
  "mobile": "077 123 4567",
  "email": "{{email}}",
  "password": "{{password}}"
}

### Verify email (token from the newest file in App_Data/dev-emails/)
POST {{host}}/api/auth/verify-email
Content-Type: application/json

{ "token": "paste-token-here" }

### Sign in as a web client (refresh token is set as an HttpOnly cookie)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}", "rememberMe": true }

### Sign in as the mobile app (refresh token in the response body)
POST {{host}}/api/auth/login
Content-Type: application/json
X-Client-Type: mobile

{ "email": "{{email}}", "password": "{{password}}", "rememberMe": false }

### Current user
GET {{host}}/api/auth/me
Authorization: Bearer {{login.response.body.accessToken}}

### Refresh (web: cookie; mobile: send { "refreshToken": "..." })
POST {{host}}/api/auth/refresh

### Forgot password
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{ "email": "{{email}}" }

### Applications awaiting review, customers and staff (Fleet Administrator token)
# Customers must be approved here before they can sign in.
GET {{host}}/api/auth/applications?status=pending
Authorization: Bearer {{login.response.body.accessToken}}

### Sign out
POST {{host}}/api/auth/logout

# ───────────── Orders (Operational Coordinator) ─────────────
# Sign in with the shared test coordinator first (password: ask Prasad, or your own if you seeded the accounts).

@coordinatorEmail = coordinator@fleetsync.local
@coordinatorPassword = paste-the-test-account-password

### Sign in as the test coordinator
# @name coordinator
POST {{host}}/api/auth/login
Content-Type: application/json
X-Client-Type: mobile

{ "email": "{{coordinatorEmail}}", "password": "{{coordinatorPassword}}", "rememberMe": false }

### Submitted orders: All open (default tab)
GET {{host}}/api/orders
Authorization: Bearer {{coordinator.response.body.accessToken}}

### Submitted orders: Needs quotation, second page of 5
GET {{host}}/api/orders?tab=needs-quotation&page=2&pageSize=5
Authorization: Bearer {{coordinator.response.body.accessToken}}

### Submitted orders: Quoted, searching for a customer
GET {{host}}/api/orders?tab=quoted&search=matale
Authorization: Bearer {{coordinator.response.body.accessToken}}

### Submitted orders: Closed
GET {{host}}/api/orders?tab=closed
Authorization: Bearer {{coordinator.response.body.accessToken}}

### Order details with quotation and history
GET {{host}}/api/orders/ORD-1039
Authorization: Bearer {{coordinator.response.body.accessToken}}

### Unknown order → 404 orders.not_found
GET {{host}}/api/orders/ORD-9999
Authorization: Bearer {{coordinator.response.body.accessToken}}

### Bad tab → 400 validation_failed
GET {{host}}/api/orders?tab=everything
Authorization: Bearer {{coordinator.response.body.accessToken}}

### No token → 401
GET {{host}}/api/orders
