{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Jwt": {
      "Issuer": "fleetsync-api",
      "Audience": "fleetsync-clients",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 1,
      "RememberMeRefreshTokenDays": 30
    },
    "Links": {
      "WebAppBaseUrl": "http://localhost:5173",
      "ActivationUrl": "fleetsync://activate"
    },
    "Tokens": {
      "EmailVerificationHours": 48,
      "PasswordResetMinutes": 60,
      "StaffActivationDays": 7
    },
    "Documents": {
      "StoragePath": "App_Data/staff-documents",
      "MaxFileSizeBytes": 5242880,
      "MaxFileCount": 5
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "RateLimiting": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
