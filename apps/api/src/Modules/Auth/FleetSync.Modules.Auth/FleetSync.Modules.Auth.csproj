<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FleetSync Auth module.
    A self-contained part of the modular monolith: it owns its own entities,
    database schema ("identity"), migrations and HTTP endpoints. The host
    (FleetSync.Api) only calls AddAuthModule() and MapAuthEndpoints().
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FleetSync.Modules.Auth</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives the module ASP.NET Core types (endpoints, auth, HttpContext) without being a web app itself. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Module internals stay internal; only the test projects may see them. -->
    <InternalsVisibleTo Include="FleetSync.Modules.Auth.UnitTests" />
    <InternalsVisibleTo Include="FleetSync.IntegrationTests" />
  </ItemGroup>

</Project>
