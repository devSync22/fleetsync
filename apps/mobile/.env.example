# Copy to .env.local (gitignored) and set your API URL.
# On a phone with Expo Go, use your computer's LAN IP, not localhost, and start the API
# so it listens on the network: dotnet run --project apps/api/src/FleetSync.Api --urls http://0.0.0.0:5215
# (Android emulator: http://10.0.2.2:5215/api · iOS simulator: http://localhost:5215/api)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5215/api
