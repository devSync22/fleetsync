{
  "name": "fleetsync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "check:mobile": "npm exec --workspace=apps/mobile -- tsc --noEmit"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
